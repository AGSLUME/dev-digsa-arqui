# Entorno local de la sesión integradora (desfase +0). Generado por infra/generar-env.sh. NO SE VERSIONA.
LUME_SESION=integradora
DESFASE=0

# Puertos (ADR-010)
GATEWAY_PUERTO=9000
SEGURIDAD_PUERTO=9101
VISITAS_PUERTO=9102
REPORTES_PUERTO=9103
NOTIFICACIONES_PUERTO=9104
HOLA_PUERTO=9109
ANGULAR_PUERTO=4200
PG_PUERTO=5440
RABBITMQ_PUERTO=5672
RABBITMQ_CONSOLA_PUERTO=15672
REDIS_PUERTO=6380
PROMETHEUS_PUERTO=9090
GRAFANA_PUERTO=3000
ZIPKIN_PUERTO=9411
MONOLITO_PUERTO=9050

# URLs que leen los servicios Spring (corren en el host)
LUME_EMISOR=http://localhost:9000
LUME_SEGURIDAD_URL=http://localhost:9101
LUME_HOLA_URL=http://localhost:9109
LUME_FRONTEND_URL=http://localhost:4200
DIGSA_MONOLITO_URL=http://localhost:9050
REDIS_HOST=localhost
REDIS_USUARIO_GATEWAY=gateway
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
JAVA_TOOL_OPTIONS=-Xmx384m

# Correo local: Mailpit ya instalado (no se levanta otro). Datos ficticios con dominio propio de la sesión.
LUME_SMTP_HOST=127.0.0.1
LUME_SMTP_PUERTO=1025
LUME_DOMINIO_PRUEBA=integradora.prueba.local

# Claves locales aleatorias
PG_CLAVE_ADMIN=<generada-por-generar-env.sh>
SEGURIDAD_DB_CLAVE=<generada-por-generar-env.sh>
VISITAS_DB_CLAVE=<generada-por-generar-env.sh>
REPORTES_DB_CLAVE=<generada-por-generar-env.sh>
NOTIFICACIONES_DB_CLAVE=<generada-por-generar-env.sh>
RABBITMQ_CLAVE_ADMIN=<generada-por-generar-env.sh>
REDIS_CLAVE_GATEWAY=<generada-por-generar-env.sh>
GRAFANA_CLAVE_ADMIN=<generada-por-generar-env.sh>

# Andamiaje del emisor (I1; S1 lo reemplaza). {noop} solo se admite en local.
LUME_GATEWAY_SECRETO=<generada-por-generar-env.sh>
LUME_GATEWAY_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_HUMO_SECRETO=<generada-por-generar-env.sh>
LUME_HUMO_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_USUARIO_DEV=dev.integradora
LUME_CLAVE_DEV=<generada-por-generar-env.sh>
LUME_PERFIL_DEV=ADMINISTRADOR
