# Entorno local de la sesión integradora (desfase +0). Generado por infra/generar-env.sh. NO SE VERSIONA.
LUME_SESION=integradora
DESFASE=0

# Puertos (ADR-010)
GATEWAY_PUERTO=9000
SEGURIDAD_PUERTO=9101
VISITAS_PUERTO=9102
REPORTES_PUERTO=9103
NOTIFICACIONES_PUERTO=9104
HOLA_PUERTO=9109
ANGULAR_PUERTO=4200
PG_PUERTO=5440
RABBITMQ_PUERTO=5672
RABBITMQ_CONSOLA_PUERTO=15672
REDIS_PUERTO=6380
PROMETHEUS_PUERTO=9090
GRAFANA_PUERTO=3000
ZIPKIN_PUERTO=9411
MONOLITO_PUERTO=9050

# URLs que leen los servicios Spring (corren en el host)
LUME_EMISOR=http://localhost:9000
LUME_SEGURIDAD_URL=http://localhost:9101
LUME_VISITAS_URL=http://localhost:9102
LUME_HOLA_URL=http://localhost:9109
LUME_URL_SEGURA=false
LUME_FRONTEND_URL=http://localhost:4200
DIGSA_MONOLITO_URL=http://localhost:9050
REDIS_HOST=localhost
REDIS_USUARIO_GATEWAY=gateway
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
JAVA_TOOL_OPTIONS=-Xmx384m

# Correo local: Mailpit ya instalado (no se levanta otro). Datos ficticios con dominio propio de la sesión.
LUME_SMTP_HOST=127.0.0.1
LUME_SMTP_PUERTO=1025
LUME_DOMINIO_PRUEBA=integradora.prueba.local

# Claves locales aleatorias
PG_CLAVE_ADMIN=<generada-por-generar-env.sh>
SEGURIDAD_DB_CLAVE=<generada-por-generar-env.sh>
VISITAS_DB_CLAVE=<generada-por-generar-env.sh>
REPORTES_DB_CLAVE=<generada-por-generar-env.sh>
NOTIFICACIONES_DB_CLAVE=<generada-por-generar-env.sh>
# Roles dueños del esquema, solo para Flyway (D8)
SEGURIDAD_DB_CLAVE_DDL=<generada-por-generar-env.sh>
VISITAS_DB_CLAVE_DDL=<generada-por-generar-env.sh>
REPORTES_DB_CLAVE_DDL=<generada-por-generar-env.sh>
NOTIFICACIONES_DB_CLAVE_DDL=<generada-por-generar-env.sh>
RABBITMQ_CLAVE_ADMIN=<generada-por-generar-env.sh>
REDIS_CLAVE_GATEWAY=<generada-por-generar-env.sh>
GRAFANA_CLAVE_ADMIN=<generada-por-generar-env.sh>
# Usuarios de RabbitMQ por servicio (ADR-006)
SEGURIDAD_RABBIT_USUARIO=seguridad
SEGURIDAD_RABBIT_CLAVE=<generada-por-generar-env.sh>
VISITAS_RABBIT_USUARIO=visitas
VISITAS_RABBIT_CLAVE=<generada-por-generar-env.sh>
REPORTES_RABBIT_USUARIO=reportes
REPORTES_RABBIT_CLAVE=<generada-por-generar-env.sh>
NOTIFICACIONES_RABBIT_USUARIO=notificaciones
NOTIFICACIONES_RABBIT_CLAVE=<generada-por-generar-env.sh>
GATEWAY_RABBIT_USUARIO=gateway
GATEWAY_RABBIT_CLAVE=<generada-por-generar-env.sh>

# Andamiaje del emisor (I1; S1 lo reemplaza). {noop} solo se admite en local.
LUME_GATEWAY_SECRETO=<generada-por-generar-env.sh>
LUME_GATEWAY_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_HUMO_SECRETO=<generada-por-generar-env.sh>
LUME_HUMO_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
# Clientes de máquina del emisor (client_credentials). En claro para quien llama; codificado para seguridad. {noop} solo en local.
LUME_VISITAS_SECRETO=<generada-por-generar-env.sh>
LUME_VISITAS_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_REPORTES_SECRETO=<generada-por-generar-env.sh>
LUME_REPORTES_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_NOTIFICACIONES_SECRETO=<generada-por-generar-env.sh>
LUME_NOTIFICACIONES_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_MONOLITO_SECRETO=<generada-por-generar-env.sh>
LUME_MONOLITO_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_SEGURIDAD_SECRETO=<generada-por-generar-env.sh>
LUME_SEGURIDAD_SECRETO_CODIFICADO='{noop}<generada-por-generar-env.sh>'
LUME_USUARIO_DEV=dev.integradora
LUME_CLAVE_DEV=<generada-por-generar-env.sh>
LUME_PERFIL_DEV=ADMINISTRADOR

# Emisor (S1): clave AES-256 que cifra las claves de firma en la tabla jwk. Vault en el cierre (I9).
LUME_JWK_CLAVE=<generada-por-generar-env.sh>
# Visitas: clave AES-256 que cifra el token del enlace del OPL guardado para el correo del acta (decisión del usuario). Vault en I9.
VISITAS_OPL_CLAVE=<generada-por-generar-env.sh>
